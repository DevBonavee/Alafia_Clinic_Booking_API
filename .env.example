# Local development (.env). The docker-compose database:
DATABASE_URL=postgres://postgres:postgres@localhost:5434/clinic
# Shared secret clients send in the X-API-Key header.
API_KEY=
PORT=3000

# Production values go in .env.local (gitignored) and are read by `npm run migrate:prod`
# and `npm run smoke:prod`:
#   DATABASE_URL=<Neon pooled connection string, host contains -pooler, sslmode=require>
#   API_KEY=<long random key, e.g. openssl rand -hex 24>
#   BASE_URL=https://<project>.vercel.app
