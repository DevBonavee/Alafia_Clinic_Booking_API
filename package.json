{
  "name": "alafia-clinic-booking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "tsx --env-file=.env.local scripts/migrate.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:prod": "tsx --env-file=.env.local scripts/smoke.ts --yes",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
